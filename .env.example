# Copy to .env and fill in only what you need — every line here is optional.
# Nothing below is required to run: leave the file out entirely and shelf-cmd
# still starts, shares shelves through the default hub, and works offline for AI.

# Web port (matches the published port in docker-compose.yml)
PORT=3016

# Only override if you run your own Postgres instead of the bundled one.
# DATABASE_URL=postgresql://shelf:shelf@localhost:5432/shelf

# ── Sharing shelves with other people ──────────────────────────────────────
# Shared shelves federate through a hub. Leave HUB_URL unset to use the public
# default hub — sharing then works out of the box. Run your own shelf-hub
# (https://github.com/jessekward-prog/shelf-hub) and point at it here for full
# independence; every instance sharing a given shelf must use the same hub.
# HUB_URL=https://your-hub.up.railway.app
# HUB_SYNC=off        # turn off all hub polling (private-only, no sharing)
# HUB_SYNC_MS=30000   # how often to pull linked shelves, in milliseconds

# ── Optional: AI descriptions and tutorial plans ───────────────────────────
# Any OpenAI-compatible chat server (e.g. LM Studio) reachable from the app.
# Without it the app works fine — AI fields just stay blank.
# LM_STUDIO_URL=http://localhost:1234
# LM_STUDIO_MODEL=
# LM_STUDIO_API_KEY=

# ── Optional: Twitch embeds ────────────────────────────────────────────────
# Required only if you save Twitch clips AND reach shelf-cmd at a real domain.
# Must match the domain in your browser's address bar exactly.
# TWITCH_PARENT=your-domain.com
